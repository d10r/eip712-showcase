# WalletConnect project ID (required for Web3Modal)
VITE_WALLET_CONNECT_PROJECT_ID=your_project_id

# ClearMacro forwarder addresses (deterministic across chains)
# Set either the plain forwarder or the Permit2-capable superset, but not both.
# If VITE_CLEAR_MACRO_FORWARDER_WITH_PERMIT2_ADDRESS is set, it is used for both
# plain and Permit2 flows.
VITE_CLEAR_MACRO_FORWARDER_ADDRESS=0x...
VITE_CLEAR_MACRO_FORWARDER_WITH_PERMIT2_ADDRESS=0x...

# FlowScheduler ClearMacro per chain (chainId or network name from SF metadata)
# VITE_11155420_FLOW_SCHEDULER_CLEAR_MACRO_ADDRESS=0x...   # OP Sepolia
# VITE_8453_FLOW_SCHEDULER_CLEAR_MACRO_ADDRESS=0x...      # Base

# Optional: Permit2 address override (defaults to canonical 0x000000000022D473030F116dDEE9F6B43aC78BA3)
# VITE_PERMIT2_ADDRESS=0x...

# Optional: ClearMacro Provider URL for "Execute via provider"
# VITE_CLEARMACRO_PROVIDER_URL=http://127.0.0.1:3001
