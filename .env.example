# To be created at https://cloud.reown.com/
VITE_WALLET_CONNECT_PROJECT_ID=...

# Macro Forwarder addresses are deterministic (same across chains); support is detected via RPC.
VITE_CLEAR_SIGNING_FORWARDER_ADDRESS=0x712Fc5863F53AFBa980207006cfd74F6c25fE055
VITE_PERMIT2_CLEAR_SIGNING_FORWARDER_ADDRESS=0x712F1ccD0472025EC75bB67A92AA6406cDA0031D

# Macro addresses are chain-specific (not deterministic). Use chainId or SF metadata canonical name:
#   VITE_<chainId>_FLOW_SCHEDULER_712_MACRO_ADDRESS    e.g. VITE_8453_... for Base
#   VITE_<UPPERCASE_NAME>_FLOW_SCHEDULER_712_MACRO_ADDRESS   e.g. VITE_BASE_MAINNET_...
VITE_OPTIMISM_SEPOLIA_FLOW_SCHEDULER_712_MACRO_ADDRESS=0x7b043b577A10b06296FE0bD0402F5025d97A3839
# VITE_BASE_MAINNET_FLOW_SCHEDULER_712_MACRO_ADDRESS=0x...   # after deploying macro to Base
# VITE_8453_FLOW_SCHEDULER_712_MACRO_ADDRESS=0x...           # same, by chainId

# Optional. Relayer base URL for "Execute via relayer" (e.g. http://localhost:3000).
VITE_RELAYER_URL=http://localhost:3000

# Permit2 (optional). Defaults to canonical 0x000000000022D473030F116dDEE9F6B43aC78BA3 if unset.
# VITE_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
