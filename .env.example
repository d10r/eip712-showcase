# To be created at https://cloud.reown.com/
VITE_WALLET_CONNECT_PROJECT_ID=...

# FlowScheduler view (OP Sepolia). Required when using FlowScheduler on that chain.
# For Permit2 flow, use Permit2MacroForwarder address. If unset, falls back to ONLY712 address.
VITE_OP_SEPOLIA_ONLY712_FORWARDER_ADDRESS=0x...
VITE_OP_SEPOLIA_PERMIT2_MACRO_FORWARDER_ADDRESS=0x...
VITE_OP_SEPOLIA_FLOW_SCHEDULER_712_MACRO_ADDRESS=0x...

# Optional. Relayer base URL for "Execute via relayer" (e.g. http://localhost:3000).
VITE_RELAYER_URL=http://localhost:3000

# Permit2 (optional). Defaults to canonical 0x000000000022D473030F116dDEE9F6B43aC78BA3 if unset.
# VITE_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
# Optional wrapper for atomic Permit2 + runPermit2AndMacro execution.
# VITE_PERMIT2_MACRO_WRAPPER_ADDRESS=0x...
